{
  "name": "@oli/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OLI (codename) — frontend. Talks to the Worker API under /api/v1.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:live": "vite --mode live",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract"
  },
  "dependencies": {
    "@oli/contracts": "file:../../packages/contracts",
    "@tanstack/react-query": "5.104.3",
    "border-beam": "1.4.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "thinking-orbs": "0.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
