# Only NON-secret values here. Anything VITE_* is public in the browser bundle.
# Model keys / Hermes keys live in Worker secrets, never here.

# mock = in-browser fake API (no backend needed) | live = real Worker
VITE_API_MODE=mock

# Same-origin by default. Change only if the API lives on another origin
# (then the Worker must send CORS + credentials headers).
VITE_API_BASE=/api/v1

# Dev proxy target for `npm run dev:live` (wrangler dev default). Not exposed to the browser.
OLI_API_PROXY=http://localhost:8787

# P1/P2 feature flags (UI is hidden unless "true")
VITE_FEATURE_AGENT_ACCESS=false
VITE_FEATURE_CHAT=false
VITE_FEATURE_CLEARANCE=false
