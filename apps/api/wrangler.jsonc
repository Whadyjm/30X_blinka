{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oli-api",
  "account_id": "fbaa64f96579f93b2db32a1eb12ff6c9",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "oli30x.ultramare.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oli-demo",
      "database_id": "349afff1-8b3b-4673-929b-ce6936c68d3a",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "r2_buckets": [
    {
      "binding": "INVOICES",
      "bucket_name": "oli-invoice-tests"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PUBLIC_APP_URL": "https://oli30x.ultramare.dev",
    "DEMO_ORG_ID": "org_demo",
    "DEMO_USER_ID": "user_demo_owner"
  },
  "queues": {
    "producers": [
      {
        "binding": "TELEGRAM_QUEUE",
        "queue": "oli-telegram"
      },
      {
        "binding": "INVOICE_QUEUE",
        "queue": "oli-invoices"
      }
    ],
    "consumers": [
      {
        "queue": "oli-telegram",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 2
      },
      {
        "queue": "oli-invoices",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "oli-invoices-dead",
        "retry_delay": 30
      }
    ]
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
